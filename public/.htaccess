# Club de Esgrima Torremolinos — reglas de Apache para el hosting OVH.
# Generado junto al export estático de Next.js (ver next.config.ts).

# Servir la web estática antes que el index.php del WordPress anterior,
# cuyos archivos siguen en el servidor como respaldo.
DirectoryIndex index.html

RewriteEngine On

# 1) Forzar HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2) Forzar el dominio canónico con "www" (es el que tiene el tráfico y el
#    posicionamiento en Google — ver auditoría SEO previa a esta migración)
RewriteCond %{HTTP_HOST} ^esgrimatorremolinos\.com [NC]
RewriteRule ^ https://www.esgrimatorremolinos.com%{REQUEST_URI} [L,R=301]

# 3) URLs heredadas del WordPress anterior (permalinks sin resolver bajo
#    /index.php/<slug>/), indexadas y con tráfico real: se redirigen 301
#    a la misma ruta limpia para no perder el posicionamiento ganado.
RewriteRule ^index\.php/horarios-y-precios/?$ https://www.esgrimatorremolinos.com/horarios-y-precios/ [L,R=301]
RewriteRule ^index\.php/contacto/?$ https://www.esgrimatorremolinos.com/contacto/ [L,R=301]
RewriteRule ^index\.php/instalaciones/?$ https://www.esgrimatorremolinos.com/instalaciones/ [L,R=301]
RewriteRule ^index\.php/clase-gratis/?$ https://www.esgrimatorremolinos.com/clase-gratis/ [L,R=301]
RewriteRule ^index\.php/esgrima-ninos/?$ https://www.esgrimatorremolinos.com/esgrima-ninos/ [L,R=301]
RewriteRule ^index\.php/esgrima-para-adultos/?$ https://www.esgrimatorremolinos.com/esgrima-para-adultos/ [L,R=301]
RewriteRule ^index\.php/esgrima-en-silla-de-ruedas/?$ https://www.esgrimatorremolinos.com/esgrima-en-silla-de-ruedas/ [L,R=301]
RewriteRule ^index\.php/preguntas-frecuentes/?$ https://www.esgrimatorremolinos.com/preguntas-frecuentes/ [L,R=301]
RewriteRule ^index\.php/politica-de-privacidad/?$ https://www.esgrimatorremolinos.com/politica-de-privacidad/ [L,R=301]
RewriteRule ^index\.php/aviso-legal/?$ https://www.esgrimatorremolinos.com/aviso-legal/ [L,R=301]
RewriteRule ^index\.php/politica-de-cookies-ue/?$ https://www.esgrimatorremolinos.com/politica-de-cookies-ue/ [L,R=301]

# 4) Contenido heredado de la plantilla de demostración original y del
#    post de bienvenida por defecto de WordPress: sin tráfico real, se
#    redirigen a la home en vez de servir un 404.
RewriteRule ^index\.php/skt-karate/?$ https://www.esgrimatorremolinos.com/ [L,R=301]
RewriteRule ^index\.php/skt-karate-2/?$ https://www.esgrimatorremolinos.com/ [L,R=301]
RewriteRule ^index\.php/2022/06/22/bonjour-tout-le-monde/?$ https://www.esgrimatorremolinos.com/ [L,R=301]

# 5) Cualquier otra URL /index.php/... que quedara suelta, a la home.
RewriteRule ^index\.php/ / [L,R=301]

# 6) Ficheros de configuración y datos que el navegador nunca debe pedir
#    directamente (los PHP los leen desde el disco): claves, listas de
#    reservas y funciones comunes.
<FilesMatch "(-config\.php|-lib\.php|\.jsonl|\.jsonl\.bak)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

ErrorDocument 404 /404.html

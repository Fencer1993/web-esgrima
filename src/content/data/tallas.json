{
  "intro": "Antes de pedir, mídete con una cinta métrica de costura (mejor si te ayuda alguien) y compara con la tabla de la marca que vas a comprar. Si estás entre dos tallas, elige la mayor. Y si dudas, pregúntanos en clase o por WhatsApp: te probamos el material del club para acertar.",
  "howToMeasure": [
    {
      "part": "Altura",
      "how": "Descalzo o descalza, de espaldas a la pared y con la espalda recta."
    },
    {
      "part": "Pecho",
      "how": "Contorno en la parte más ancha del pecho, por debajo de las axilas, respirando con normalidad."
    },
    {
      "part": "Cintura",
      "how": "Contorno en la parte más estrecha del tronco, sin apretar la cinta."
    },
    {
      "part": "Cadera",
      "how": "Contorno en la parte más ancha de la cadera y los glúteos."
    },
    {
      "part": "Cabeza (careta)",
      "how": "Contorno de la cabeza por encima de las cejas y las orejas."
    },
    {
      "part": "Mano (guante)",
      "how": "Contorno de la mano armada a la altura de los nudillos, sin el pulgar y sin apretar."
    },
    {
      "part": "Pie (zapatillas)",
      "how": "Pide por talla europea (EU). Si estás entre dos tallas, la mayor, para llevar media de esgrima."
    }
  ],
